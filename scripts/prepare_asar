#!/usr/bin/env bash
set -euxo pipefail

unzip -o "$HOSTED_CODEX_APP_ZIP" -d scratch/
asar extract "scratch/ChatGPT.app/Contents/Resources/app.asar" "scratch/asar"
cp assets/* scratch/asar/webview/
PWA_SOURCE_ICON="scratch/asar/webview/assets/app-f483cb0295ed.png"
PWA_TARGET_ICON="scratch/asar/webview/assets/pwa-icon-512.png"
PWA_ICON_SIZE=512
PWA_TOTAL_PADDING_PERCENT=25
PWA_CONTENT_SIZE=$((PWA_ICON_SIZE * (100 - PWA_TOTAL_PADDING_PERCENT) / 100))
PWA_PADDING_TOTAL=$((PWA_ICON_SIZE - PWA_CONTENT_SIZE))
PWA_PADDING_BEFORE=$((PWA_PADDING_TOTAL / 2))
PWA_PADDING_AFTER=$((PWA_PADDING_TOTAL - PWA_PADDING_BEFORE))
sharp -i "$PWA_SOURCE_ICON" -o "$PWA_TARGET_ICON" -f png resize "$PWA_CONTENT_SIZE" "$PWA_CONTENT_SIZE" --fit inside -- flatten white -- extend "$PWA_PADDING_BEFORE" "$PWA_PADDING_AFTER" "$PWA_PADDING_BEFORE" "$PWA_PADDING_AFTER" --background white -- removeAlpha
if [[ -n "${DEV:-}" ]]; then
  prettier --ignore-path /dev/null --ignore-unknown --write "scratch/asar"
else
  patched_files=()
  while IFS= read -r patched_file; do
    patched_files+=("$patched_file")
  done < <(
    awk '/^\+\+\+ b\//{sub(/^\+\+\+ b\//, "scratch/asar/"); print}' patches/*.patch | sort -u
  )
  prettier --ignore-path /dev/null --ignore-unknown --write "${patched_files[@]}"
fi
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-remove-csp.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-style.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-preload.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-favicon.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-pwa.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-thread-title.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-initial-route.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-electron-shim-close-sidebar.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-prosemirror-inputmode.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-use-atfs-for-local-files.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-statsig-override-adapter.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-disable-in-app-browser.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-pets-unavailable.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-hide-desktop-menu.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-file-context-actions.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-hide-default-file-target.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-trusted-ips-settings.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-website-preview.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-profile-logout-label.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-hide-terminal-source-hint.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-prompt-search-param.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/sentry-disable-shell.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/sentry-disable-webview.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/preload-disable-device-check.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-safe-header-left.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-catalog-stalled-pagination.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-artifact-file-actions.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-sidebar-files.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-file-breadcrumb-native.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-file-tab-folder-root.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-file-launcher-projectless.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-terminal-cwd-follow.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-browser-file-drop.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-linked-archive-download.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-image-preview-remove.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-conversation-file-preview.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-conversation-search-button.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/app-host-json-rpc.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/app-host-browser-windows.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/app-terminal-cwd-report.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-open-thread-browser-tab.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-mobile-viewport.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-disable-pets-shortcuts.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-help-about-search-style.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-computer-use-unavailable.patch
patch --batch --forward --strip 1 --directory scratch/asar < patches/webview-automations-unavailable.patch
python3 scripts/patch_webview_project_locale.py
rm -rf scratch/asar/node_modules/better-sqlite3
./scripts/prepare_native_terminal
node ./scripts/compress_webview_assets.mjs
